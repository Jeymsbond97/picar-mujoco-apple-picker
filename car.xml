<mujoco model="car_with_camera">
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.3 0.3 0.35 1"/>

    <body name="chassis" pos="0 0 0.15">
      <freejoint/>
      <geom type="box" size="0.2 0.15 0.05" rgba="0.2 0.6 0.9 1"/>

      <body name="front_left_wheel" pos="0.15 0.18 -0.07">
        <joint name="front_left_hinge" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.03" euler="90 0 0" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="front_right_wheel" pos="0.15 -0.18 -0.07">
        <joint name="front_right_hinge" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.03" euler="90 0 0" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="rear_left_wheel" pos="-0.15 0.18 -0.07">
        <joint name="rear_left_hinge" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.03" euler="90 0 0" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="rear_right_wheel" pos="-0.15 -0.18 -0.07">
        <joint name="rear_right_hinge" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.03" euler="90 0 0" rgba="0.1 0.1 0.1 1"/>
      </body>

      <body name="camera_mount" pos="0.1 0 0.08">
        <joint name="camera_hinge" type="hinge" axis="0 0 1" limited="false"/>
        <geom type="cylinder" size="0.03 0.02" rgba="0.9 0.15 0.15 1"/>
        <geom type="box" size="0.015 0.03 0.015" pos="0.03 0 0" rgba="0.9 0.15 0.15 1"/>
        <camera name="car_camera" pos="0.05 0 0" xyaxes="0 -1 0 0 0 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
